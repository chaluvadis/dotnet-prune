{
  "name": "dotnet-prune-vscode",
  "displayName": "DotNet Prune",
  "description": "Visualize unused .NET code in VS Code with hierarchical tree view showing findings organized by solution, project, and files.",
  "version": "0.0.8",
  "publisher": "nomad-in-code",
  "icon": "resources/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chaluvadis/dotnet-prune"
  },
  "homepage": "https://github.com/chaluvadis/dotnet-prune",
  "bugs": {
    "url": "https://github.com/chaluvadis/dotnet-prune/issues"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Linters"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dotnetprune.refresh",
        "title": "Refresh Findings",
        "category": "DotNetPrune",
        "icon": "$(refresh)"
      },
      {
        "command": "dotnetprune.runAnalysis",
        "title": "Run Analysis",
        "category": "DotNetPrune",
        "icon": "$(play)"
      },
      {
        "command": "dotnetprune.clearFindings",
        "title": "Clear Findings",
        "category": "DotNetPrune",
        "icon": "$(clear-all)"
      },
      {
        "command": "dotnetprune.openFinding",
        "title": "Open Finding",
        "icon": "$(go-to-file)"
      },
      {
        "command": "dotnetprune.showFindingDetails",
        "title": "Show Details",
        "category": "DotNetPrune",
        "icon": "$(info)"
      },
      {
        "command": "dotnetprune.copyFilePath",
        "title": "Copy File Path",
        "icon": "$(copy)"
      },
      {
        "command": "dotnetprune.copyProjectName",
        "title": "Copy Project Name",
        "icon": "$(copy)"
      },
      {
        "command": "dotnetprune.filterBySymbolKind",
        "title": "Filter by Type",
        "category": "DotNetPrune",
        "icon": "$(filter)"
      },
      {
        "command": "dotnetprune.filterByConfidence",
        "title": "Filter by Confidence",
        "category": "DotNetPrune",
        "icon": "$(filter)"
      },
      {
        "command": "dotnetprune.filterByProject",
        "title": "Filter by Project",
        "category": "DotNetPrune",
        "icon": "$(filter)"
      },
      {
        "command": "dotnetprune.searchFindings",
        "title": "Search Findings",
        "category": "DotNetPrune",
        "icon": "$(search)"
      },
      {
        "command": "dotnetprune.clearFilters",
        "title": "Clear Filters",
        "category": "DotNetPrune",
        "icon": "$(clear-all)"
      },
      {
        "command": "dotnetprune.toggleGroupByType",
        "title": "Group by Type",
        "category": "DotNetPrune",
        "icon": "$(files)"
      },
      {
        "command": "dotnetprune.toggleViewMode",
        "title": "Toggle Compact/Full View",
        "category": "DotNetPrune",
        "icon": "$(list-flat)"
      },
      {
        "command": "dotnetprune.toggleShowDeletable",
        "title": "Show Only Deletable",
        "category": "DotNetPrune",
        "icon": "$(trash)"
      },
      {
        "command": "dotnetprune.bulkIgnore",
        "title": "Bulk Ignore",
        "category": "DotNetPrune",
        "icon": "$(circle-slash)"
      },
      {
        "command": "dotnetprune.bulkDelete",
        "title": "Bulk Delete",
        "category": "DotNetPrune",
        "icon": "$(trash)"
      },
      {
        "command": "dotnetprune.exportFindings",
        "title": "Export Findings",
        "category": "DotNetPrune",
        "icon": "$(export)"
      },
      {
        "command": "dotnetprune.ignoreFinding",
        "title": "Ignore Finding",
        "icon": "$(circle-slash)"
      },
      {
        "command": "dotnetprune.deleteFinding",
        "title": "Delete Unused",
        "icon": "$(trash)"
      },
      {
        "command": "dotnetprune.analyzePackages",
        "title": "Analyze Packages",
        "category": "DotNetPrune",
        "icon": "$(search)"
      },
      {
        "command": "dotnetprune.refreshPackages",
        "title": "Refresh Packages",
        "category": "DotNetPrune",
        "icon": "$(refresh)"
      },
      {
        "command": "dotnetprune.clearPackages",
        "title": "Clear Packages",
        "category": "DotNetPrune",
        "icon": "$(clear-all)"
      },
      {
        "command": "dotnetprune.previewPruneProject",
        "title": "Preview Prune",
        "category": "DotNetPrune",
        "icon": "$(eye)"
      },
      {
        "command": "dotnetprune.applyPruneProject",
        "title": "Apply Prune",
        "category": "DotNetPrune",
        "icon": "$(trash)"
      },
      {
        "command": "dotnetprune.previewPrunePackage",
        "title": "Preview Remove",
        "category": "DotNetPrune",
        "icon": "$(eye)"
      },
      {
        "command": "dotnetprune.applyPrunePackage",
        "title": "Remove Package",
        "category": "DotNetPrune",
        "icon": "$(trash)"
      },
      {
        "command": "dotnetprune.exportPruneReport",
        "title": "Export Report",
        "category": "DotNetPrune",
        "icon": "$(export)"
      },
      {
        "command": "dotnetprune.suppressPackage",
        "title": "Add to Allowlist",
        "category": "DotNetPrune",
        "icon": "$(circle-slash)"
      },
      {
        "command": "dotnetprune.openAllowlistConfig",
        "title": "Edit Allowlist",
        "category": "DotNetPrune",
        "icon": "$(edit)"
      },
      {
        "command": "dotnetprune.goToPackageReference",
        "title": "Go to Reference",
        "category": "DotNetPrune",
        "icon": "$(go-to-file)"
      },
      {
        "command": "dotnetprune.reanalyzePackages",
        "title": "Re-analyze",
        "category": "DotNetPrune",
        "icon": "$(sync)"
      },
      {
        "command": "dotnetprune.filterPackagesByConfidence",
        "title": "Filter by Confidence",
        "category": "DotNetPrune",
        "icon": "$(filter)"
      },
      {
        "command": "dotnetprune.clearCache",
        "title": "Clear Cache",
        "category": "DotNetPrune",
        "icon": "$(clear-all)"
      },
      {
        "command": "dotnetprune.forceFullAnalysis",
        "title": "Force Full Analysis",
        "category": "DotNetPrune",
        "icon": "$(bug)"
      },
      {
        "command": "dotnetprune.ignoreFindingByLocation",
        "title": "Ignore Finding",
        "category": "DotNetPrune",
        "icon": "$(circle-slash)"
      },
      {
        "command": "dotnetprune.deleteFindingByLocation",
        "title": "Delete Unused",
        "category": "DotNetPrune",
        "icon": "$(trash)"
      },
      {
        "command": "dotnetprune.exportMetrics",
        "title": "Export Metrics",
        "category": "DotNetPrune",
        "icon": "$(export)"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "DotNetPrune",
      "properties": {
        "dotnetprune.analysis.includePublicSymbols": {
          "type": "boolean",
          "default": true,
          "description": "Include public symbols in the analysis. (Reserved for future use — not yet passed to the analyzer CLI.)"
        },
        "dotnetprune.analysis.includeInternalSymbols": {
          "type": "boolean",
          "default": true,
          "description": "Include internal symbols in the analysis. (Reserved for future use — not yet passed to the analyzer CLI.)"
        },
        "dotnetprune.analysis.excludeGeneratedCode": {
          "type": "boolean",
          "default": true,
          "description": "Exclude auto-generated code from analysis. (Reserved for future use — not yet passed to the analyzer CLI.)"
        },
        "dotnetprune.analysis.mode": {
          "type": "string",
          "enum": [
            "strict",
            "loose"
          ],
          "default": "loose",
          "description": "Analysis mode: strict (fewer false positives) or loose (more comprehensive). (Reserved for future use — not yet passed to the analyzer CLI.)"
        },
        "dotnetprune.analysis.detectDeadCode": {
          "type": "boolean",
          "default": false,
          "description": "Detect dead/unreachable code (experimental). (Reserved for future use — not yet passed to the analyzer CLI.)"
        },
        "dotnetprune.analysis.detectTodoComments": {
          "type": "boolean",
          "default": false,
          "description": "Detect TODO/HACK/FIXME comments. (Reserved for future use — not yet passed to the analyzer CLI.)"
        },
        "dotnetprune.filter.exclusionPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/bin/**",
            "**/obj/**",
            "**/node_modules/**"
          ],
          "description": "Glob patterns to exclude from analysis. (Reserved for future use — not yet passed to the analyzer CLI.)"
        },
        "dotnetprune.filter.inclusionPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.cs",
            "**/*.sln",
            "**/*.csproj"
          ],
          "description": "Glob patterns to include in analysis. (Reserved for future use — not yet passed to the analyzer CLI.)"
        },
        "dotnetprune.filter.symbolKinds": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Method",
              "Property",
              "Field",
              "Parameter",
              "Type",
              "Class",
              "Interface",
              "Struct",
              "Enum"
            ]
          },
          "default": [
            "Method",
            "Property",
            "Field",
            "Parameter",
            "Type"
          ],
          "description": "Symbol kinds to analyze. (Reserved for future use — not yet passed to the analyzer CLI.)"
        },
        "dotnetprune.filter.confidenceLevel": {
          "type": "string",
          "enum": [
            "all",
            "high",
            "medium",
            "low"
          ],
          "default": "all",
          "description": "Filter findings by confidence level: all, high (>=80), medium (50-79), low (<50)"
        },
        "dotnetprune.ui.enableInlineHighlighting": {
          "type": "boolean",
          "default": true,
          "description": "Highlight unused code inline in the editor"
        },
        "dotnetprune.ui.showConfidence": {
          "type": "boolean",
          "default": true,
          "description": "Show confidence levels in findings"
        },
        "dotnetprune.ui.showSeverity": {
          "type": "boolean",
          "default": true,
          "description": "Show severity levels in findings"
        },
        "dotnetprune.performance.enableCaching": {
          "type": "boolean",
          "default": true,
          "description": "Cache analysis results to improve performance. (Reserved for future use — not yet passed to the analyzer CLI.)"
        },
        "dotnetprune.performance.parallelAnalysis": {
          "type": "boolean",
          "default": true,
          "description": "Enable parallel analysis of projects. (Reserved for future use — not yet passed to the analyzer CLI.)"
        },
        "dotnetprune.performance.enableIncrementalAnalysis": {
          "type": "boolean",
          "default": true,
          "description": "Enable incremental analysis - only re-analyze changed files since last run. Uses file hash comparison to detect changes."
        },
        "dotnetprune.integration.enableProblemsPanel": {
          "type": "boolean",
          "default": true,
          "description": "Show findings in VS Code Problems panel"
        },
        "dotnetprune.integration.enableCodeActions": {
          "type": "boolean",
          "default": true,
          "description": "Enable Quick Fix code actions for unused code"
        },
        "dotnetprune.autoRefreshOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically re-run analysis when a C# file is saved"
        },
        "dotnetprune.maxFindings": {
          "type": "number",
          "default": 1000,
          "minimum": 1,
          "description": "Maximum number of findings to display"
        },
        "dotnetprune.excludeGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional glob patterns to exclude from analysis. (Reserved for future use — not yet passed to the analyzer CLI.)"
        },
        "dotnetprune.analyzerPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to the FindUnused analyzer DLL. Leave empty to use the bundled analyzer."
        },
        "dotnetprune.minConfidence": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 100,
          "description": "Minimum confidence level (0-100) to display findings"
        },
        "dotnetprune.logLevel": {
          "type": "string",
          "enum": [
            "off",
            "error",
            "warn",
            "info",
            "debug"
          ],
          "default": "info",
          "description": "Log verbosity level for the DotNetPrune output channel"
        },
        "dotnetprune.prune.runRestoreAfterPrune": {
          "type": "boolean",
          "default": false,
          "description": "Run `dotnet restore` after applying a prune operation to validate the project still restores cleanly"
        },
        "dotnetprune.prune.runBuildAfterPrune": {
          "type": "boolean",
          "default": false,
          "description": "Run `dotnet build` after applying a prune operation to validate the project still compiles"
        },
        "dotnetprune.prune.allowlistPath": {
          "type": "string",
          "default": "",
          "description": "Path to a `.dotnet-prune.json` allowlist file. Leave empty to use `<workspaceRoot>/.dotnet-prune.json`"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dotnetprune-views",
          "title": "DotNetPrune",
          "icon": "resources/gray.png"
        }
      ]
    },
    "views": {
      "dotnetprune-views": [
        {
          "id": "dotnetprune-findings",
          "name": "Findings",
          "icon": "resources/icon.png"
        },
        {
          "id": "dotnetprune-packages",
          "name": "Package References",
          "icon": "resources/icon.png"
        },
        {
          "id": "dotnetprune-metrics",
          "name": "Metrics",
          "icon": "resources/icon.png"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "dotnetprune.runAnalysis",
          "when": "view == dotnetprune-findings",
          "group": "navigation@1",
          "icon": "$(play)"
        },
        {
          "command": "dotnetprune.searchFindings",
          "when": "view == dotnetprune-findings",
          "group": "navigation@2",
          "icon": "$(search)"
        },
        {
          "command": "dotnetprune.exportFindings",
          "when": "view == dotnetprune-findings",
          "group": "navigation@3",
          "icon": "$(export)"
        },
        {
          "command": "dotnetprune.clearFilters",
          "when": "view == dotnetprune-findings",
          "group": "1_filters@1",
          "icon": "$(clear-all)"
        },
        {
          "command": "dotnetprune.filterBySymbolKind",
          "when": "view == dotnetprune-findings",
          "group": "1_filters@2",
          "icon": "$(symbol-class)"
        },
        {
          "command": "dotnetprune.filterByConfidence",
          "when": "view == dotnetprune-findings",
          "group": "1_filters@3",
          "icon": "$(pulse)"
        },
        {
          "command": "dotnetprune.filterByProject",
          "when": "view == dotnetprune-findings",
          "group": "1_filters@4",
          "icon": "$(file-submodule)"
        },
        {
          "command": "dotnetprune.clearCache",
          "when": "view == dotnetprune-findings",
          "group": "2_utilities@1",
          "icon": "$(clear-all)"
        },
        {
          "command": "dotnetprune.forceFullAnalysis",
          "when": "view == dotnetprune-findings",
          "group": "2_utilities@2",
          "icon": "$(bug)"
        },
        {
          "command": "dotnetprune.toggleGroupByType",
          "when": "view == dotnetprune-findings",
          "group": "navigation@4",
          "icon": "$(file-tree)"
        },
        {
          "command": "dotnetprune.toggleViewMode",
          "when": "view == dotnetprune-findings",
          "group": "navigation@5",
          "icon": "$(list-flat)"
        },
        {
          "command": "dotnetprune.toggleShowDeletable",
          "when": "view == dotnetprune-findings",
          "group": "1_filters@5",
          "icon": "$(trash)"
        },
        {
          "command": "dotnetprune.analyzePackages",
          "when": "view == dotnetprune-packages",
          "group": "navigation@1",
          "icon": "$(search)"
        },
        {
          "command": "dotnetprune.refreshPackages",
          "when": "view == dotnetprune-packages",
          "group": "navigation@2",
          "icon": "$(refresh)"
        },
        {
          "command": "dotnetprune.clearPackages",
          "when": "view == dotnetprune-packages",
          "group": "navigation@3",
          "icon": "$(clear-all)"
        },
        {
          "command": "dotnetprune.exportPruneReport",
          "when": "view == dotnetprune-packages",
          "group": "navigation@4",
          "icon": "$(export)"
        },
        {
          "command": "dotnetprune.filterPackagesByConfidence",
          "when": "view == dotnetprune-packages",
          "group": "navigation@5",
          "icon": "$(pulse)"
        },
        {
          "command": "dotnetprune.openAllowlistConfig",
          "when": "view == dotnetprune-packages",
          "group": "1_config@1",
          "icon": "$(edit)"
        }
      ],
      "view/item/context": [
        {
          "command": "dotnetprune.copyFilePath",
          "when": "view == dotnetprune-findings && viewItem == file",
          "group": "7_modification@1",
          "icon": "$(copy)"
        },
        {
          "command": "dotnetprune.copyProjectName",
          "when": "view == dotnetprune-findings && viewItem == project",
          "group": "7_modification@1",
          "icon": "$(copy)"
        },
        {
          "command": "dotnetprune.ignoreFinding",
          "when": "view == dotnetprune-findings && viewItem == finding",
          "group": "2_workspace@1",
          "icon": "$(circle-slash)"
        },
        {
          "command": "dotnetprune.deleteFinding",
          "when": "view == dotnetprune-findings && viewItem == finding",
          "group": "2_workspace@2",
          "icon": "$(trash)"
        },
        {
          "command": "dotnetprune.previewPruneProject",
          "when": "view == dotnetprune-packages && viewItem =~ /^pkg-group-unused/",
          "group": "1_prune@1",
          "icon": "$(eye)"
        },
        {
          "command": "dotnetprune.applyPruneProject",
          "when": "view == dotnetprune-packages && viewItem == pkg-group-unused-pruneable",
          "group": "1_prune@2",
          "icon": "$(trash)"
        },
        {
          "command": "dotnetprune.previewPrunePackage",
          "when": "view == dotnetprune-packages && viewItem =~ /^pkg-unused-(high|medium)$/",
          "group": "1_prune@1",
          "icon": "$(eye)"
        },
        {
          "command": "dotnetprune.applyPrunePackage",
          "when": "view == dotnetprune-packages && viewItem =~ /^pkg-unused-(high|medium)$/",
          "group": "1_prune@2",
          "icon": "$(trash)"
        },
        {
          "command": "dotnetprune.suppressPackage",
          "when": "view == dotnetprune-packages && viewItem =~ /^pkg-unused/",
          "group": "2_suppress@1",
          "icon": "$(circle-slash)"
        },
        {
          "command": "dotnetprune.goToPackageReference",
          "when": "view == dotnetprune-packages && viewItem =~ /^pkg-unused/",
          "group": "3_navigate@1",
          "icon": "$(go-to-file)"
        },
        {
          "command": "dotnetprune.goToPackageReference",
          "when": "view == dotnetprune-packages && viewItem == pkg-referenced",
          "group": "3_navigate@1",
          "icon": "$(go-to-file)"
        },
        {
          "command": "dotnetprune.showFindingDetails",
          "when": "view == dotnetprune-findings && viewItem == finding",
          "group": "3_info@1",
          "icon": "$(info)"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc --noEmit && node esbuild.js",
    "clean": "rm -rf *.vsix dist",
    "dotnet:publish": "dotnet publish ./FindUnused/FindUnused.csproj -c Release -p:PublishWithAspNetCoreMaterialLock=false -p:_WarnOnBuildLocatorIssue=false --output ./dist/FindUnused/",
    "package": "pnpm clean && pnpm compile && pnpm dotnet:publish && vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/node": "26.2.0",
    "@biomejs/biome": "^2.5.7",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}